rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedDoctor() {
      return isSignedIn()
        && request.auth.token.doctor_verified == true
        && request.auth.token.sama_license is string
        && request.auth.token.sama_license.size() >= 4;
    }

    // Per-family encrypted backup / preferences sync scoped strictly by UID.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Maternal & Child Telehealth SBAR consultation queue.
    match /consult_requests/{ticketId} {
      // Patient can only view their own consultation tickets; verified doctors can triage queue.
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || isVerifiedDoctor());

      // Patient can create a new ticket strictly under their own UID with pending_triage status.
      allow create: if isSignedIn()
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.status == 'pending_triage'
        && request.resource.data.profileName is string
        && request.resource.data.sbarSummary is string
        && request.resource.data.sbarSummary.size() <= 4000;

      // Only SAMA-verified doctors can assign themselves and update triage status/notes.
      // Patient UID and original SBAR intake fields remain immutable.
      allow update: if isVerifiedDoctor()
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.sbarSummary == resource.data.sbarSummary
        && request.resource.data.status in ['in_review', 'completed', 'referred']
        && request.resource.data.assignedDoctorName is string;

      // Patients may cancel/delete their own pending ticket.
      allow delete: if isSignedIn()
        && resource.data.patientUid == request.auth.uid
        && resource.data.status == 'pending_triage';
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
